# Basispfad des Deployments.
# GitHub Pages (Projektseite): /<repo-name>/   – wird im Workflow gesetzt
# Eigene Domain oder lokale Entwicklung: /
VITE_BASE=/

# Absolute Seiten-URL inkl. abschließendem "/".
# Wird für canonical, og:url und og:image genutzt.
# Leer lassen ist erlaubt – dann bleiben die Pfade relativ.
VITE_SITE_URL=
